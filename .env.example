# Porta HTTP
PORT=3000

# Diretório persistente para as imagens
DATA_DIR=./data

# Token usado apenas para uploads/remoções pelo painel
UPLOAD_TOKEN=troca-este-token

# Token opcional para proteger o endpoint MCP
# Deixa vazio para acesso sem bearer auth durante testes.
MCP_TOKEN=

# URL pública do site, opcional; usada apenas para metadata.
PUBLIC_BASE_URL=http://localhost:3000
